[Unit]
Description=SAHIIX API (FastAPI v6)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sahiix
ExecStart=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml up -d api
ExecStop=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml stop api
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target