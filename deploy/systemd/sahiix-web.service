[Unit]
Description=SAHIIX Web Console (Next.js 16)
After=docker.service sahiix-api.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sahiix
ExecStart=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml up -d web
ExecStop=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml stop web
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target