[Unit]
Description=Ollama Local LLM Server
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sahiix
ExecStart=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml up -d ollama
ExecStop=/usr/bin/docker-compose -f deploy/docker-compose.prod.yml stop ollama
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target