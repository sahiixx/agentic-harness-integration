# Azure AI Foundry
AZURE_FOUNDRY_API_KEY=your_key_here
AZURE_FOUNDRY_BASE_URL=https://your-resource.openai.azure.com/openai/deployments
AZURE_DEFAULT_MODEL=gpt-5.6-sol
AZURE_JUDGE_MODEL=claude-opus-5
AZURE_EMBED_MODEL=text-embedding-3-large

# Database & Cache
DATABASE_URL=postgresql://user:pass@db:5432/harness
REDIS_URL=redis://redis:6379/0

# Tool APIs
APOLLO_API_KEY=your_apollo_key
BRIGHTDATA_API_KEY=your_brightdata_key
WATI_API_KEY=your_wati_key

# Auth
JWT_SECRET=change-me-in-production
RATE_LIMIT_PER_MINUTE=60
