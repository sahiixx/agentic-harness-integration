# SAHIIX Production Environment Template
# Copy to .env.production and fill ALL values

# ─── Database ───
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ─── Auth ───
JWT_SECRET=CHANGE_ME_32_CHAR_MIN_OPENSSL_RAND_HEX_32

# ─── AI Providers ───
XAI_API_KEY=CHANGE_ME_xai-...                    # https://x.ai/api
FREETHEAI_API_KEY=CHANGE_ME_freetheai-key        # Discord: /signup + daily /checkin
PUTER_AUTH_TOKEN=CHANGE_ME_puter-token           # https://puter.com dashboard
GROK_MODEL=grok-4.6

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=CHANGE_ME_123456:ABC-DEF...   # @BotFather
TELEGRAM_CHAT_ID=CHANGE_ME_123456789             # @userinfobot
TELEGRAM_ADMIN_USERNAME=CHANGE_ME_your_username  # Your Telegram @username

# ─── Monitoring ───
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ─── Domain ───
DOMAIN=yourdomain.com

# ─── Optional: S3 Backup ───
S3_ENDPOINT=https://s3.amazonaws.com             # Or MinIO/Wasabi/DigitalOcean Spaces
S3_BUCKET=sahiix-backups
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ─── Internal URLs (don't change) ───
SAHIIX_OS_BASE=http://hermes:8765
PUBLIC_TUNNEL=https://${DOMAIN}